# 1Password references for `op run --env-file=.env.op -- <cmd>`.
# Copy to .env.op (gitignored), point each at the real item. Values never touch
# disk or stdout: op injects them into the child process only.
#
# Used by: scripts/register-commands.ts, scripts/smoke-post.ts,
#          scripts/strip-components.ts, and `wrangler secret put` at deploy.

DISCORD_APPLICATION_ID=op://Orrey/Discord application/application id
DISCORD_PUBLIC_KEY=op://Orrey/Discord application/public key
DISCORD_BOT_TOKEN=op://Orrey/Discord application/bot token
DISCORD_CLIENT_SECRET=op://Orrey/Discord application/client secret
DISCORD_GUILD_ID=op://Orrey/Discord application/guild id

GOOGLE_CALENDAR_ID=op://Orrey/Google service account/calendar id
GOOGLE_SERVICE_ACCOUNT_EMAIL=op://Orrey/Google service account/client email
GOOGLE_SERVICE_ACCOUNT_KEY=op://Orrey/Google service account/private key

CONSOLE_SESSION_SECRET=op://Orrey/Console/session secret
