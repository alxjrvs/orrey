{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orrey",
  "main": "src/index.ts",
  // Newest date the test pool's workerd accepts; bump when @cloudflare/vitest-pool-workers does.
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // The console is a static SPA served from the same origin as the API.
  "assets": { "directory": "./public", "binding": "ASSETS", "not_found_handling": "single-page-application" },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "orrey",
      "database_id": "6d2002e5-7c34-48ee-8177-7d29422160ce",
      "migrations_dir": "drizzle"
    }
  ],

  // Outbound projection only: Google Calendar and Discord *scheduled events*.
  // Discord messages are send-only and never queued for reconciliation.
  "queues": {
    "producers": [{ "binding": "OUTBOX", "queue": "orrey-outbox" }],
    "consumers": [
      {
        "queue": "orrey-outbox",
        "max_batch_size": 10,
        "max_batch_timeout": 10,
        "max_retries": 5,
        "dead_letter_queue": "orrey-outbox-dlq"
      }
    ]
  },

  "durable_objects": {
    "bindings": [
      { "name": "GUILD", "class_name": "GuildGovernor" },
      { "name": "SESSION_LOCK", "class_name": "SessionLock" },
      { "name": "POLL_LOCK", "class_name": "PollLock" }
    ]
  },
  // A class cannot be added to an existing tag — v1 is already applied to the
  // deployed Worker, so PollLock arrives under its own. Getting this wrong is a
  // deploy-time failure, not a test-time one.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GuildGovernor", "SessionLock"] },
    { "tag": "v2", "new_sqlite_classes": ["PollLock"] }
  ],

  // One trigger; src/cron/scheduled.ts derives the hourly and daily work from
  // the time. Workers Free allows five cron triggers per *account*.
  "triggers": { "crons": ["* * * * *"] },

  // The deployed value. `wrangler dev` overrides it from .dev.vars.
  "vars": {
    "ENVIRONMENT": "production",
    // Where Google pushes calendar notifications. The cron has no request to
    // take an origin from, so it is stated here. Google refuses to deliver to
    // an unverified domain — this hostname has to be verified once in the
    // Google console before a real channel can be opened, which is not code and
    // no test can stand in for it.
    "PUBLIC_ORIGIN": "https://orrey.alxjrvs.workers.dev"
  }
}
