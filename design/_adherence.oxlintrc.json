{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/data/**",
              "components/discord/**",
              "components/nav/**",
              "ui_kits/console/**",
              "ui_kits/discord/**",
              "ui_kits/entry/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Space Grotesk|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Space Grotesk, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|full|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, disabled, full, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|label|disabled|onChange|style|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: checked, label, disabled, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Column'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|width|align|key|ref|className|style|children)$/]",
        "message": "<Column> doesn't accept that prop. Declared props: label, width, align."
      },
      {
        "selector": "JSXOpeningElement[name.name='Column'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|right|center)$/]",
        "message": "<Column> align must be one of 'left' | 'right' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DayHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:lead|gutter|day|relative|colSpan|asRow|style|key|ref|className|style|children)$/]",
        "message": "<DayHeader> doesn't accept that prop. Declared props: lead, gutter, day, relative, colSpan, asRow, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DiscordButtonSpec'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|style|count|emoji|disabled|onClick|key|ref|className|style|children)$/]",
        "message": "<DiscordButtonSpec> doesn't accept that prop. Declared props: label, style, count, emoji, disabled, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='DiscordButtonSpec'] > JSXAttribute[name.name='style'] > Literal[value!=/^(?:primary|secondary|success|danger|link)$/]",
        "message": "<DiscordButtonSpec> style must be one of 'primary' | 'secondary' | 'success' | 'danger' | 'link'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmbedField'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|value|inline|key|ref|className|style|children)$/]",
        "message": "<EmbedField> doesn't accept that prop. Declared props: name, value, inline."
      },
      {
        "selector": "JSXOpeningElement[name.name='DiscordMessage'] > JSXAttribute > JSXIdentifier[name!=/^(?:author|bot|timestamp|avatarInitials|children|key|ref|className|style|children)$/]",
        "message": "<DiscordMessage> doesn't accept that prop. Declared props: author, bot, timestamp, avatarInitials, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='DiscordSelectOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|count|key|ref|className|style|children)$/]",
        "message": "<DiscordSelectOption> doesn't accept that prop. Declared props: label, count."
      },
      {
        "selector": "JSXOpeningElement[name.name='EphemeralNote'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|dismissable|key|ref|className|style|children)$/]",
        "message": "<EphemeralNote> doesn't accept that prop. Declared props: children, dismissable."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|error|required|children|key|ref|className|style|children)$/]",
        "message": "<Field> doesn't accept that prop. Declared props: label, hint, error, required, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|meta|actions|flush|children|key|ref|className|style|children)$/]",
        "message": "<Panel> doesn't accept that prop. Declared props: title, meta, actions, flush, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pill'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|dot|children|key|ref|className|style|children)$/]",
        "message": "<Pill> doesn't accept that prop. Declared props: tone, dot, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pill'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|in|maybe|out|accent|idle)$/]",
        "message": "<Pill> tone must be one of 'neutral' | 'in' | 'maybe' | 'out' | 'accent' | 'idle'."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuorumMeter'] > JSXAttribute > JSXIdentifier[name!=/^(?:inCount|maybeCount|outCount|total|quorum|showCount|size|key|ref|className|style|children)$/]",
        "message": "<QuorumMeter> doesn't accept that prop. Declared props: inCount, maybeCount, outCount, total, quorum, showCount, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='RosterRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|initials|role|intent|attended|note|key|ref|className|style|children)$/]",
        "message": "<RosterRow> doesn't accept that prop. Declared props: name, initials, role, intent, attended, note."
      },
      {
        "selector": "JSXOpeningElement[name.name='RosterRow'] > JSXAttribute[name.name='intent'] > Literal[value!=/^(?:in|out|maybe|silent)$/]",
        "message": "<RosterRow> intent must be one of 'in' | 'out' | 'maybe' | 'silent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentedFilter'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|value|onChange|key|ref|className|style|children)$/]",
        "message": "<SegmentedFilter> doesn't accept that prop. Declared props: options, value, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<SelectOption> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='SessionRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:when|time|inlineTime|title|subtitle|attendance|state|selected|key|ref|className|style|children)$/]",
        "message": "<SessionRow> doesn't accept that prop. Declared props: when, time, inlineTime, title, subtitle, attendance, state, selected."
      },
      {
        "selector": "JSXOpeningElement[name.name='SessionRow'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:confirmed|jeopardy|open|unposted|cancelled|played)$/]",
        "message": "<SessionRow> state must be one of 'confirmed' | 'jeopardy' | 'open' | 'unposted' | 'cancelled' | 'played'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sidebar'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<Sidebar> doesn't accept that prop. Declared props: children."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<StatusBar> doesn't accept that prop. Declared props: children."
      },
      {
        "selector": "JSXOpeningElement[name.name='SyncChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|label|children|key|ref|className|style|children)$/]",
        "message": "<SyncChip> doesn't accept that prop. Declared props: status, label, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='SyncChip'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:ok|stale|down|off)$/]",
        "message": "<SyncChip> status must be one of 'ok' | 'stale' | 'down' | 'off'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SyncLogEntry'] > JSXAttribute > JSXIdentifier[name!=/^(?:at|text|tone|key|ref|className|style|children)$/]",
        "message": "<SyncLogEntry> doesn't accept that prop. Declared props: at, text, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='SyncLogEntry'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:read|write|error)$/]",
        "message": "<SyncLogEntry> tone must be one of 'read' | 'write' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:mono|children|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: mono, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='TopBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<TopBar> doesn't accept that prop. Declared props: children."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
