# Copy to .dev.vars for `wrangler dev`. Production values go in `wrangler secret put`.

# Discord application (the repurposed Hermuz app)
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=

# Google service account with `writer` on the Orrey calendar
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY=

# Console session signing
CONSOLE_SESSION_SECRET=
